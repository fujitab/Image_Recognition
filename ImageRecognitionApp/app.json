{
  "expo": {
    "name": "画像認識アプリ",
    "slug": "ImageRecognitionApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "アプリで画像認識を行うために、カメラへのアクセスが必要です。",
        "NSPhotoLibraryUsageDescription": "アプリで画像認識を行うために、写真ライブラリへのアクセスが必要です。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "アプリで画像認識を行うために、カメラへのアクセスが必要です。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "アプリで画像認識を行うために、写真ライブラリへのアクセスが必要です。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
